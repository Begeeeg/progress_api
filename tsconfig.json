{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",

        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "resolveJsonModule": true,
        "sourceMap": true,

        "types": ["node"],

        "noImplicitAny": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
